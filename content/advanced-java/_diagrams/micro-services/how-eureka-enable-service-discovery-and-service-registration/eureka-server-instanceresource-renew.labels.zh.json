    "c01": "/**",
    "c02": " * A put request for renewing lease from a client instance.",
    "c03": " *",
    "c04": " * @param isReplication",
    "c05": " *            a header parameter containing information whether this is",
    "c06": " *            replicated from other nodes.",
    "c07": " * @param overriddenStatus",
    "c08": " *            overridden status if any.",
    "c09": " * @param status",
    "c10": " *            the {@link InstanceStatus} of the instance.",
    "c11": " * @param lastDirtyTimestamp",
    "c12": " *            last timestamp when this instance information was updated.",
    "c13": " * @return response indicating whether the operation was a success or",
    "c14": " *         failure.",
    "c15": " */",
    "c16": "@PUT",
    "c17": "public Response renewLease(",
    "c18": "        @HeaderParam(PeerEurekaNode.HEADER_REPLICATION) String isReplication,",
    "c19": "        @QueryParam(\"overriddenstatus\") String overriddenStatus,",
    "c20": "        @QueryParam(\"status\") String status,",
    "c21": "        @QueryParam(\"lastDirtyTimestamp\") String lastDirtyTimestamp) {",
    "c22": "    boolean isFromReplicaNode = \"true\".equals(isReplication);",
    "c23": "    boolean isSuccess = registry.renew(app.getName(), id, isFromReplicaNode);",
    "c25": "    // Not found in the registry, immediately ask for a register",
    "c26": "    if (!isSuccess) {",
    "c27": "        logger.warn(\"Not Found (Renew): {} - {}\", app.getName(), id);",
    "c28": "        return Response.status(Status.NOT_FOUND).build();",
    "c29": "    }",
