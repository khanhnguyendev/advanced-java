    {
      "key": "c02",
      "x": 506,
      "y": 80,
      "anchor": "start",
      "literals": [
        " * A put request for renewing lease from a client instance."
      ]
    },
    {
      "key": "c03",
      "x": 506,
      "y": 116,
      "anchor": "start",
      "literals": [
        " *"
      ]
    },
    {
      "key": "c04",
      "x": 506,
      "y": 152,
      "anchor": "start",
      "literals": [
        " * @param isReplication"
      ]
    },
    {
      "key": "c05",
      "x": 506,
      "y": 188,
      "anchor": "start",
      "literals": [
        " *            a header parameter containing information whether this is"
      ]
    },
    {
      "key": "c06",
      "x": 506,
      "y": 224,
      "anchor": "start",
      "literals": [
        " *            replicated from other nodes."
      ]
    },
    {
      "key": "c07",
      "x": 506,
      "y": 260,
      "anchor": "start",
      "literals": [
        " * @param overriddenStatus"
      ]
    },
    {
      "key": "c08",
      "x": 506,
      "y": 296,
      "anchor": "start",
      "literals": [
        " *            overridden status if any."
      ]
    },
    {
      "key": "c09",
      "x": 506,
      "y": 332,
      "anchor": "start",
      "literals": [
        " * @param status"
      ]
    },
    {
      "key": "c10",
      "x": 506,
      "y": 368,
      "anchor": "start",
      "literals": [
        " *            the {@link InstanceStatus} of the instance."
      ]
    },
    {
      "key": "c11",
      "x": 506,
      "y": 404,
      "anchor": "start",
      "literals": [
        " * @param lastDirtyTimestamp"
      ]
    },
    {
      "key": "c12",
      "x": 506,
      "y": 440,
      "anchor": "start",
      "literals": [
        " *            last timestamp when this instance information was updated."
      ]
    },
    {
      "key": "c13",
      "x": 506,
      "y": 476,
      "anchor": "start",
      "literals": [
        " * @return response indicating whether the operation was a success or"
      ]
    },
    {
      "key": "c14",
      "x": 506,
      "y": 512,
      "anchor": "start",
      "literals": [
        " *         failure."
      ]
    },
    {
      "key": "c15",
      "x": 506,
      "y": 548,
      "anchor": "start",
      "literals": [
        " */"
      ]
    },
    {
      "key": "c16",
      "x": 506,
      "y": 584,
      "anchor": "start",
      "literals": [
        "@PUT"
      ]
    },
    {
      "key": "c17",
      "x": 506,
      "y": 620,
      "anchor": "start",
      "literals": [
        "public Response renewLease("
      ]
    },
    {
      "key": "c18",
      "x": 506,
      "y": 656,
      "anchor": "start",
      "literals": [
        "        @HeaderParam(PeerEurekaNode.HEADER_REPLICATION) String isReplication,"
      ]
    },
    {
      "key": "c19",
      "x": 506,
      "y": 692,
      "anchor": "start",
      "literals": [
        "        @QueryParam(\"overriddenstatus\") String overriddenStatus,"
      ]
    },
    {
      "key": "c20",
      "x": 506,
      "y": 728,
      "anchor": "start",
      "literals": [
        "        @QueryParam(\"status\") String status,"
      ]
    },
    {
      "key": "c21",
      "x": 506,
      "y": 764,
      "anchor": "start",
      "literals": [
        "        @QueryParam(\"lastDirtyTimestamp\") String lastDirtyTimestamp) {"
      ]
    },
    {
      "key": "c22",
      "x": 506,
      "y": 800,
      "anchor": "start",
      "literals": [
        "    boolean isFromReplicaNode = \"true\".equals(isReplication);"
      ]
    },
    {
      "key": "c23",
      "x": 506,
      "y": 836,
      "anchor": "start",
      "literals": [
        "    boolean isSuccess = registry.renew(app.getName(), id, isFromReplicaNode);"
      ]
    },
    {
      "key": "c25",
      "x": 506,
      "y": 908,
      "anchor": "start",
      "literals": [
        "    // Not found in the registry, immediately ask for a register"
      ]
    },
    {
      "key": "c26",
      "x": 506,
      "y": 944,
      "anchor": "start",
      "literals": [
        "    if (!isSuccess) {"
      ]
    },
    {
      "key": "c27",
      "x": 506,
      "y": 980,
      "anchor": "start",
      "literals": [
        "        logger.warn(\"Not Found (Renew): {} - {}\", app.getName(), id);"
      ]
    },
    {
      "key": "c28",
      "x": 506,
      "y": 1016,
      "anchor": "start",
      "literals": [
        "        return Response.status(Status.NOT_FOUND).build();"
      ]
    },
    {
      "key": "c29",
      "x": 506,
      "y": 1052,
      "anchor": "start",
      "literals": [
        "    }"
      ]
    }
