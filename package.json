    "check:translations": "tsx scripts/check-translations.ts",
    "e2e": "playwright test",
    "search:gate": "tsx scripts/search-gate/run.ts"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-parse": "^9.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
